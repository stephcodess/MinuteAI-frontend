{
  "name": "minuteai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "vite --config vite.electron.config.ts",
    "electron:build": "vite build --config vite.electron.config.ts && electron-builder --config electron-builder.config.cjs",
    "electron:build:win": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false vite build --config vite.electron.config.ts && electron-builder --win --config electron-builder.config.cjs",
    "electron:build:win:dir": "vite build --config vite.electron.config.ts && electron-builder --win --dir --config electron-builder.config.cjs",
    "electron:build:mac": "vite build --config vite.electron.config.ts && electron-builder --mac --config electron-builder.config.cjs"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "@stripe/react-stripe-js": "^6.4.0",
    "@stripe/stripe-js": "^9.6.0",
    "disposable-email-domains": "^1.0.62",
    "electron-updater": "^6.3.9",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-electron": "^0.28.8"
  }
}